# Tags below are replaced with verified immutable digests in infra/images.lock.env.
POSTGRES_IMAGE=postgres:18.0
REDIS_IMAGE=redis:7.4.5-alpine
PYTHON_IMAGE=python:3.12.9-slim
NODE_IMAGE=node:24.14.0-alpine
NGINX_IMAGE=nginx:1.28.0-alpine
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.131.1
