ADF_REDIS_PASSWORD_FILE=../.bootstrap/secrets/redis-password
ADF_WORKER_REDIS_PASSWORD_FILE=../.bootstrap/secrets/redis-worker-password
ADF_REDIS_MONITOR_PASSWORD_FILE=../.bootstrap/secrets/redis-monitor-password
ADF_REDIS_ACL_FILE=../.bootstrap/secrets/redis-acl
ADF_ADMIN_TOKEN_FILE=../.bootstrap/secrets/admin-token
ADF_ORCHESTRATOR_TOKEN_FILE=../.bootstrap/secrets/orchestrator-token
ADF_WORKER_TOKEN_FILE=../.bootstrap/secrets/worker-token
ADF_ALLOWED_ROOTS=["/home/alex/ai-factory/projects"]
