{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_port": {
          "default": "out",
          "enum": [
            "out",
            "true",
            "false"
          ],
          "title": "Source Port",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "target_port": {
          "const": "in",
          "default": "in",
          "title": "Target Port",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "JsonValue": {},
    "Node": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Config",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeType": {
      "enum": [
        "start",
        "planner",
        "agent_task",
        "condition",
        "parallel_fork",
        "parallel_join",
        "test",
        "review",
        "approval",
        "git_commit",
        "end"
      ],
      "title": "NodeType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exported orchestrator model shape; validate_graph additionally enforces node config, ports, acyclicity, reachability, paired forks and writing gates.",
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "maxItems": 300,
      "title": "Edges",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 100,
      "minItems": 2,
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "nodes",
    "edges"
  ],
  "title": "ADF workflow DAG v1",
  "type": "object"
}
