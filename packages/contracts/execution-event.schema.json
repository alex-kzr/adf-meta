{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "time": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time"
    },
    "type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "type"
  ],
  "title": "ADF normalized worker event ingestion v1",
  "type": "object"
}
